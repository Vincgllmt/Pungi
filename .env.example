# Dossier de sortie (par défaut : ./downloads)
# PUNGI_DOWNLOAD_DIR=D:/Musique
# Nombre de pistes téléchargées en parallèle
# PUNGI_CONCURRENCY=4

# Optionnel : clés API Spotify (https://developer.spotify.com/dashboard)
# Sans elles, Pungi fonctionne quand même mais : playlists limitées à 100 titres,
# artiste = ses 10 titres populaires. Avec elles : playlists complètes et discographie entière.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Optionnel : cookies YouTube, utilisés UNIQUEMENT pour les titres soumis à vérification d'âge
# (et seulement si aucune autre version non restreinte n'est trouvée).
#
# Option A, recommandée pour Chrome / Opera / Edge : un fichier cookies.txt exporté
# (extension « Get cookies.txt LOCALLY » sur youtube.com, en étant connecté).
# Fonctionne même navigateur ouvert.
# PUNGI_COOKIES_FILE=D:/project/Pungi/cookies.txt
#
# Option B : lecture directe dans le navigateur (firefox, chrome, edge, brave, opera, vivaldi…).
# Opera GX est détecté automatiquement avec « opera ». Profil précis : navigateur:chemin_du_profil
# Les navigateurs Chromium verrouillent leurs cookies tant qu'ils sont ouverts : il faut les fermer.
# PUNGI_COOKIES_BROWSER=opera
