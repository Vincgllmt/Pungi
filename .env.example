# Dossier de sortie (par défaut : ./downloads)
# PUNGI_DOWNLOAD_DIR=D:/Musique
# Nombre de pistes téléchargées en parallèle
# PUNGI_CONCURRENCY=4

# Optionnel : clés API Spotify (https://developer.spotify.com/dashboard)
# Sans elles, Pungi fonctionne quand même mais : playlists limitées à 100 titres,
# artiste = ses 10 titres populaires. Avec elles : playlists complètes et discographie entière.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Optionnel : navigateur dont lire les cookies YouTube (titres soumis à vérification d'âge)
# PUNGI_COOKIES_BROWSER=firefox
